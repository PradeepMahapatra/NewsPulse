{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteNewsPulseSnapshots",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::REPLACE_WITH_S3_BUCKET_NAME/newspulse/snapshots/*"
    },
    {
      "Sid": "WriteLambdaLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:REPLACE_WITH_AWS_REGION:REPLACE_WITH_AWS_ACCOUNT_ID:*"
    }
  ]
}
